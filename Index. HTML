<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>I'm Sorry 💔</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    min-height: 100vh;
    overflow: hidden;
    background:
        radial-gradient(circle at top, #35104d, #100817 55%, #050207);
    color: white;
}

.screen {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
    transition: 0.8s ease;
}

.card {
    width: 100%;
    max-width: 430px;
    padding: 35px 25px;
    text-align: center;
    border-radius: 28px;

    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(18px);

    box-shadow:
        0 0 40px rgba(255, 0, 128, 0.18),
        inset 0 0 25px rgba(255,255,255,0.03);
}

.emoji {
    font-size: 65px;
    animation: heartbeat 1.5s infinite;
}

h1 {
    font-size: 34px;
    margin: 18px 0 12px;
}

h2 {
    font-size: 27px;
    margin-bottom: 15px;
}

p {
    color: #ddd;
    line-height: 1.7;
    font-size: 16px;
}

button {
    border: none;
    outline: none;
    cursor: pointer;
    color: white;
    padding: 14px 25px;
    margin: 10px 5px;
    border-radius: 50px;
    font-size: 16px;
    font-weight: bold;

    background: linear-gradient(135deg, #ff3d81, #9c27ff);
    box-shadow: 0 8px 25px rgba(255, 0, 128, 0.3);

    transition: 0.25s;
}

button:hover {
    transform: scale(1.06);
}

button:active {
    transform: scale(0.95);
}

.secondary {
    background: rgba(255,255,255,0.1);
    box-shadow: none;
}

.hidden {
    opacity: 0;
    pointer-events: none;
    transform: scale(0.85);
}

.visible {
    opacity: 1;
    pointer-events: auto;
    transform: scale(1);
}

/* Typewriter */

.typewriter {
    min-height: 80px;
    margin: 15px 0;
    font-size: 18px;
    color: #fff;
}

/* Heart */

.big-heart {
    font-size: 90px;
    animation: heartbeat 1.2s infinite;
}

/* Floating hearts */

.floating-heart {
    position: fixed;
    bottom: -50px;
    font-size: 25px;
    pointer-events: none;
    animation: floatUp linear forwards;
    z-index: 1;
}

/* Confetti */

.confetti {
    position: fixed;
    top: -20px;
    width: 9px;
    height: 15px;
    z-index: 10;
    animation: fall 3s linear forwards;
}

/* Surprise */

.surprise {
    font-size: 55px;
    margin-bottom: 15px;
    animation: bounce 1.5s infinite;
}

.small {
    font-size: 13px;
    color: #aaa;
    margin-top: 18px;
}

#noBtn {
    position: relative;
}

/* Animations */

@keyframes heartbeat {
    0%,100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.15);
    }
}

@keyframes floatUp {
    from {
        transform: translateY(0) rotate(0deg);
        opacity: 1;
    }
    to {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

@keyframes fall {
    to {
        transform: translateY(110vh) rotate(720deg);
        opacity: 0;
    }
}

@keyframes bounce {
    0%,100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-12px);
    }
}

/* Mobile */

@media(max-width: 400px) {
    h1 {
        font-size: 29px;
    }

    h2 {
        font-size: 24px;
    }

    .card {
        padding: 30px 20px;
    }

    .emoji {
        font-size: 55px;
    }
}
</style>
</head>

<body>

<!-- SCREEN 1 -->

<div class="screen visible" id="screen1">

    <div class="card">

        <div class="emoji">🥺</div>

        <h1>Hey... Wait</h1>

        <div class="typewriter" id="introText"></div>

        <button onclick="nextScreen(2)">
            Open This 💌
        </button>

        <div class="small">
            Please don't close this yet...
        </div>

    </div>

</div>


<!-- SCREEN 2 -->

<div class="screen hidden" id="screen2">

    <div class="card">

        <div class="emoji">💔</div>

        <h2>Okay... I'll say it.</h2>

        <p>
            I know I messed up.<br>
            And maybe saying "sorry" isn't enough.
        </p>

        <br>

        <p id="sorryText">
            But I genuinely want you to know...
        </p>

        <button onclick="nextScreen(3)">
            Continue 🥺
        </button>

    </div>

</div>


<!-- SCREEN 3 -->

<div class="screen hidden" id="screen3">

    <div class="card">

        <div class="emoji">😭</div>

        <h2>I'm Really Sorry.</h2>

        <div class="typewriter" id="messageText"></div>

        <button onclick="nextScreen(4)">
            One More Thing ❤️
        </button>

    </div>

</div>


<!-- SCREEN 4 -->

<div class="screen hidden" id="screen4">

    <div class="card">

        <div class="emoji">😶‍🌫️</div>

        <h2>Be Honest...</h2>

        <p>
            Are you still angry with me?
        </p>

        <br>

        <button onclick="stillAngry()">
            YES 😤
        </button>

        <button class="secondary" id="noBtn" onclick="forgiveQuestion()">
            NO 😌
        </button>

        <p class="small" id="angryText"></p>

    </div>

</div>


<!-- SCREEN 5 -->

<div class="screen hidden" id="screen5">

    <div class="card">

        <div class="big-heart">❤️</div>

        <h2>Then I have one question...</h2>

        <p>
            Will you forgive me?
        </p>

        <br>

        <button onclick="forgive()">
            YES ❤️
        </button>

        <button class="secondary" onclick="maybeForgive()">
            Maybe... 🥺
        </button>

    </div>

</div>


<!-- FINAL SCREEN -->

<div class="screen hidden" id="screen6">

    <div class="card">

        <div class="surprise">🎉</div>

        <h1>YAY! ❤️</h1>

        <p>
            Thank you for giving me another chance.
        </p>

        <br>

        <p>
            I promise I'll try to do better.
            Not just say it... but actually show it. 🫶
        </p>

        <br>

        <h2>I'm Sorry ❤️</h2>

        <p>
            And once again...
            <br>
            <b>You mean a lot to me. ✨</b>
        </p>

        <button onclick="restart()">
            Start Again 🔄
        </button>

    </div>

</div>


<script>

/* =========================
   SCREEN CHANGING
========================= */

function nextScreen(number) {

    document.querySelectorAll(".screen").forEach(screen => {
        screen.classList.remove("visible");
        screen.classList.add("hidden");
    });

    const target = document.getElementById("screen" + number);

    setTimeout(() => {
        target.classList.remove("hidden");
        target.classList.add("visible");
    }, 100);

    createHearts(8);

    if(number === 3) {
        setTimeout(() => {
            typeMessage();
        }, 700);
    }
}


/* =========================
   TYPEWRITER
========================= */

function typeWriter(element, text, speed = 45) {

    element.innerHTML = "";

    let i = 0;

    function write() {

        if(i < text.length) {

            element.innerHTML += text.charAt(i);

            i++;

            setTimeout(write, speed);
        }
    }

    write();
}


/* Opening text */

typeWriter(
    document.getElementById("introText"),
    "I know you're probably not expecting this... but I really need to say something."
);


/* Main sorry message */

function typeMessage() {

    typeWriter(
        document.getElementById("messageText"),
        "I could give excuses... but I won't. I made a mistake, and I'm genuinely sorry. 🥺"
    );

}


/* =========================
   ANGRY BUTTON
========================= */

function stillAngry() {

    const text = document.getElementById("angryText");

    text.innerHTML = "I knew it 😭... give me one tiny chance?";

    createHearts(5);

    setTimeout(() => {
        nextScreen(5);
    }, 1800);
}


/* =========================
   NO BUTTON PLAYFUL MOVE
========================= */

let noMoves = 0;

function forgiveQuestion() {

    const text = document.getElementById("angryText");

    text.innerHTML = "Really? 😳 You just made my day!";

    setTimeout(() => {
        nextScreen(5);
    }, 1200);
}


document.getElementById("noBtn").addEventListener("mouseenter", moveNoButton);

document.getElementById("noBtn").addEventListener("touchstart", moveNoButton);

function moveNoButton() {

    if(noMoves < 4) {

        const button = document.getElementById("noBtn");

        const x = Math.random() * 100 - 50;
        const y = Math.random() * 80 - 40;

        button.style.transform =
            `translate(${x}px, ${y}px)`;

        noMoves++;
    }
}


/* =========================
   FORGIVEN
========================= */

function forgive() {

    createConfetti();

    createHearts(30);

    setTimeout(() => {
        nextScreen(6);
    }, 1200);
}


/* =========================
   MAYBE
========================= */

function maybeForgive() {

    const button = event.target;

    button.innerHTML = "Please? 🥺❤️";

    createHearts(10);

    setTimeout(() => {

        button.innerHTML = "Okay... YES ❤️";

        button.onclick = forgive;

    }, 1200);
}


/* =========================
   FLOATING HEARTS
========================= */

function createHearts(amount) {

    const hearts = ["❤️","💖","💕","💗","💓","💘"];

    for(let i = 0; i < amount; i++) {

        const heart = document.createElement("div");

        heart.className = "floating-heart";

        heart.innerHTML =
            hearts[Math.floor(Math.random() * hearts.length)];

        heart.style.left =
            Math.random() * 100 + "vw";

        heart.style.animationDuration =
            (3 + Math.random() * 4) + "s";

        heart.style.fontSize =
            (18 + Math.random() * 25) + "px";

        document.body.appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 7000);
    }
}


/* =========================
   CONFETTI
========================= */

function createConfetti() {

    for(let i = 0; i < 120; i++) {

        const piece = document.createElement("div");

        piece.className = "confetti";

        piece.style.left =
            Math.random() * 100 + "vw";

        piece.style.width =
            (5 + Math.random() * 8) + "px";

        piece.style.height =
            (8 + Math.random() * 12) + "px";

        piece.style.background =
            `hsl(${Math.random() * 360}, 100%, 65%)`;

        piece.style.animationDuration =
            (2 + Math.random() * 3) + "s";

        piece.style.animationDelay =
            Math.random() * 1 + "s";

        document.body.appendChild(piece);

        setTimeout(() => {
            piece.remove();
        }, 5000);
    }
}


/* =========================
   RESTART
========================= */

function restart() {

    location.reload();

}


/* Random hearts occasionally */

setInterval(() => {

    if(Math.random() > 0.45) {
        createHearts(1);
    }

}, 1800);

</script>

</body>
</html>
